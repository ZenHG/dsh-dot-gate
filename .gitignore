# --- dependencies -------------------------------------------------------------
node_modules/
.pnpm-store/

# --- build & tool output ------------------------------------------------------
dist/
build/
coverage/
*.tsbuildinfo

# --- packaging artifacts ------------------------------------------------------
*.tgz
*.tar.gz
*.zip
dsh-dot-gate-*.tgz

# --- mutation testing ---------------------------------------------------------
# Stryker sandboxes each mutant here and writes its report tree there.
.stryker-tmp/
reports/

# --- logs, local env, editor --------------------------------------------------
*.log
npm-debug.log*
yarn-error.log*
.env
.env.*
!.env.example
.DS_Store
Thumbs.db
.idea/
.vscode/

# --- local development documents -----------------------------------------------
# Working rules for whoever edits this repo (agent or human). They describe *our*
# process, not the package, so they stay on the machine that runs them.
AGENTS.md

# --- internal research --------------------------------------------------------
# Competitor source breakdowns, official-capability notes and paper digests.
# Kept local on purpose: they quote other projects and carry our own assessment.
# Nothing here ships in the package either (see package.json "files").
.research/

# --- local experiments --------------------------------------------------------
# Packs under test that are not meant to be shared, plus scratch output.
packs/*.local.json
packs/*.draft.json
*.local.*
scratch/
tmp/

# --- secrets ------------------------------------------------------------------
.release_token
.comfy_registry_token
.npmrc
